# 复制为本目录的 .env 再填写。 .env 不会被 git 提交。
# cp .env.example .env

# 大模型 API key。留空时，「圈记号」和点记号只显示程序自己认出的说明，不联网。
PIANO_AI_API_KEY=

# 兼容 OpenAI /chat/completions 的地址。
# DeepSeek 示例：https://api.deepseek.com/v1
PIANO_AI_BASE_URL=https://api.openai.com/v1

# 模型名。DeepSeek 示例：deepseek-chat
PIANO_AI_MODEL=gpt-4o-mini
